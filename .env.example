# =============================================================================
# BMAD Viewer — Environment Configuration
# =============================================================================
# Choose ONE mode: Personal OR Multi-user.
# The app detects the mode automatically from which variables are set.

# -----------------------------------------------------------------------------
# MODE PERSONAL (self-host, single user)
# -----------------------------------------------------------------------------
# Create a Personal Access Token at https://github.com/settings/tokens
# Scopes needed: repo (for private repos), read:user
#
# NUXT_GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# -----------------------------------------------------------------------------
# MODE MULTI-USER (hosted, GitHub OAuth)
# -----------------------------------------------------------------------------
# 1. Create a GitHub OAuth App at https://github.com/settings/developers
# 2. Set Homepage URL to your domain (e.g., http://localhost:3000)
# 3. Set Authorization callback URL to: {your-domain}/auth/github
#
# NUXT_OAUTH_GITHUB_CLIENT_ID=your_client_id
# NUXT_OAUTH_GITHUB_CLIENT_SECRET=your_client_secret

# -----------------------------------------------------------------------------
# SESSION SECRET (required for Multi-user mode)
# -----------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
#
# NUXT_SESSION_PASSWORD=your-secret-key-at-least-32-characters-long

# -----------------------------------------------------------------------------
# DATABASE (optional)
# -----------------------------------------------------------------------------
# Path to the SQLite database file (default: data/bmad-viewer.db)
#
# DATABASE_PATH=data/bmad-viewer.db

# -----------------------------------------------------------------------------
# LOCAL REPO (optional) — serve sprint data from the filesystem instead of GitHub
# -----------------------------------------------------------------------------
# Set LOCAL_REPO_GITHUB_SLUG to the GitHub slug (owner/repo) whose sprint data
# should be served from a mounted local directory instead of the GitHub API.
# Then mount the host repo path in docker-compose.yml (uncomment the volume).
# The local repo is mounted read-only at /local-repo inside the container.
#
# LOCAL_REPO_GITHUB_SLUG=owner/repo
# LOCAL_REPO_HOST_PATH=/absolute/host/path/to/repo
